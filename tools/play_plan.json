{
  "page": "1080SnowboardingRecompiled.html",
  "header": [
    "1080° Snowboarding's regular plan for play_page.mjs, 2-3 minutes with every timeout counted: the launcher, Load ROM",
    "once the page has its shader list (Chrome builds the whole list behind the launcher and says when it is done, and a",
    "click while it builds is lost; Firefox builds none there, and says so as the launcher comes up), the intro and the",
    "title, the main menu, Match Race on Normal with the first rider and board, then 75 s of Crystal Lake against the",
    "rival with the default keys: leaning forward, a turn each way and a jump every 10 s. Where the game is comes from",
    "its loaded modules (tools/game_state.js), so a first run's language screen and a kept save's missing one both pass.",
    "Nothing here is timed on the game's clock: the race is downhill whatever the frame rate."
  ],
  "load": [
    ["until", "RT64: all \\d+ prebuilt shaders built|once the game draws", 45000],
    ["wait", 3000]
  ],
  "setup": [
    ["rom", 90, 437],
    ["wait", 3000]
  ],
  "start": [
    ["click", 90, 437],
    ["wait", 3000],
    ["evalFile", "game_state.js"],
    ["eval", "untilLoaded(\"titproc\", 30000)"],
    ["wait", 3000]
  ],
  "play": [
    ["hold", "Enter", "Enter", 13, 150],
    ["wait", 3000],
    ["pressUntil", "Space", " ", 32, 150, 2500, "loaded(\"mgrproc\")", 20000],
    ["wait", 2500],
    ["hold", "Space", " ", 32, 150],
    ["wait", 3500],
    ["hold", "Space", " ", 32, 150],
    ["wait", 3500],
    ["hold", "Space", " ", 32, 150],
    ["wait", 3500],
    ["hold", "Space", " ", 32, 150],
    ["wait", 3500],
    ["hold", "Space", " ", 32, 150],
    ["wait", 3500],
    ["need", "loaded(\"mgrproc\") && loaded(\"nameent\")"],
    ["eval", "modules()"],
    ["hold", "KeyW", "w", 87, 3500],
    ["hold", "KeyA", "a", 65, 600],

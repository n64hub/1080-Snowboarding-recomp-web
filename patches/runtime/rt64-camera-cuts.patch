+    void State::checkStaleWritebacks() {
+        // A display list can end without a full sync, leaving its framebuffers to be written back to
+        // RDRAM by the next one. If the CPU has meanwhile reused that memory (a game freeing its
+        // framebuffers to load a level, say), writing the old frame back would destroy the new data,
+        // which real hardware never does since the RDP writes as it draws. Skip those write-backs.
+        const Workload &workload = ext.workloadQueue->workloads[ext.workloadQueue->writeCursor];
+        for (uint32_t f = 0; f < workload.fbPairCount; f++) {
+            const FramebufferPair &fbPair = workload.fbPairs[f];
+            const uint32_t addresses[2] = { fbPair.colorImage.address, fbPair.depthImage.address };
+            for (uint32_t address : addresses) {
+                const Framebuffer *fb = framebufferManager.find(address);
+                if ((fb == nullptr) || (fb->RAMBytes == 0) || (staleWritebacks.count(address) > 0)) {
+                    continue;
+                }
+
+                if (XXH3_64bits(&RDRAM[address], fb->RAMBytes) != fb->RAMHash) {
+                    staleWritebacks.insert(address);
+                    fprintf(stderr, "[rt64] Framebuffer memory at 0x%08X was reused before its frame was written back; skipping the write-back.\n", address);
+                }
+            }
+        }
+    }

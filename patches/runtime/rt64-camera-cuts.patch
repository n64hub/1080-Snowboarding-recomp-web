+    void RSP::remapProjectionDepth(uint32_t address) {
+        // Moves what is drawn next onto a thin layer in front of a world plane, in depth only: clip z
+        // becomes squeeze * z + (1 - squeeze) * (the plane's z at that point of the screen) - layer * w.
+        // Nothing moves on screen and depth order is kept. The parameters are six floats: the plane
+        // (n.x = d as nx, ny, nz, d), then layer and squeeze. The game uses it to draw a reflection that
+        // lies below the ice as if on it, with its own depth test.
+        const uint32_t rdramAddress = fromSegmentedMasked(address);
+        const float *params = reinterpret_cast<const float *>(state->fromRDRAM(rdramAddress));
+        const double plane[4] = { params[0], params[1], params[2], -double(params[3]) };
+        const double layer = params[4];
+        const double squeeze = params[5];
+
+        if ((projectionMatrixStackSize < 1) || (projectionMatrixStackSize > RSP_EXTENDED_STACK_SIZE)) {
+            return;
+        }
+
+        // Work on aligned local copies: reading the stack entries in place let the compiler emit
+        // aligned SSE loads that faulted on the Golden Forest ice cave.
+        const int stackIndex = projectionMatrixStackSize - 1;
+        hlslpp::float4x4 viewProjMatrix;
+        hlslpp::float4x4 projMatrix;
+        memcpy(&viewProjMatrix, &viewProjMatrixStack[stackIndex], sizeof(hlslpp::float4x4));
+        memcpy(&projMatrix, &projMatrixStack[stackIndex], sizeof(hlslpp::float4x4));
+        double vp[4][4];
+        for (int r = 0; r < 4; r++) {
+            for (int c = 0; c < 4; c++) {
+                vp[r][c] = viewProjMatrix[r][c];
+            }
+        }
+
+        // The plane in clip space: clip = world * vp, so world = clip * inverse(vp) and the plane is
+        // clip . q = 0 with q = inverse(vp) * plane. Solve vp * q = plane instead of inverting.
+        double a[4][5];
+        for (int r = 0; r < 4; r++) {
+            for (int c = 0; c < 4; c++) {
+                a[r][c] = vp[r][c];
+            }
+            a[r][4] = plane[r];
+        }
+        for (int col = 0; col < 4; col++) {
+            int pivot = col;
+            for (int r = col + 1; r < 4; r++) {
+                if (std::abs(a[r][col]) > std::abs(a[pivot][col])) {
+                    pivot = r;
+                }
+            }
+            if (std::abs(a[pivot][col]) < 1e-30) {
+                return;
+            }
+            for (int c = 0; c < 5; c++) {
+                std::swap(a[col][c], a[pivot][c]);
+            }
+            for (int r = 0; r < 4; r++) {
+                if (r != col) {
+                    const double f = a[r][col] / a[col][col];
+                    for (int c = col; c < 5; c++) {
+                        a[r][c] -= f * a[col][c];
+                    }
+                }
+            }
+        }
+        double q[4];
+        for (int i = 0; i < 4; i++) {
+            q[i] = a[i][4] / a[i][i];
+        }
+        if (std::abs(q[2]) < 1e-30) {
+            return;
+        }
+
+        // Column 2 of the remap: z' = sum(c[k] * column[k]).
+        double column[4] = { -(1.0 - squeeze) * q[0] / q[2], -(1.0 - squeeze) * q[1] / q[2], squeeze, -(1.0 - squeeze) * q[3] / q[2] - layer };
+        auto remap = [&](hlslpp::float4x4 &m) {
+            for (int r = 0; r < 4; r++) {
+                double z = 0.0;
+                for (int k = 0; k < 4; k++) {
+                    z += double(m[r][k]) * column[k];
+                }
+                m[r][2] = float(z);
+            }
+        };
+        remap(viewProjMatrix);
+        remap(projMatrix);
+        memcpy(&viewProjMatrixStack[stackIndex], &viewProjMatrix, sizeof(hlslpp::float4x4));
+        memcpy(&projMatrixStack[stackIndex], &projMatrix, sizeof(hlslpp::float4x4));
+        projectionMatrixChanged = true;
+        projectionMatrixInversed = false;
+        modelViewProjChanged = true;
+    }

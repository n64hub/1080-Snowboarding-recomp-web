@@ -144,6 +145,23 @@ namespace RT64 {
 
             interop::float4x4 &prevViewProjTransform = drawData.prevViewProjTransforms[proj.transformsIndex];
             prevViewProjTransform = hlslpp::mul(prevViewTransform, prevProjTransform);
+
+            // Rebuilding the view-projection from its decomposed view and projection loses precision in the depth
+            // terms (the decomposition divides by a single, sometimes tiny, element). Depth near the far plane and
+            // the fog computed from it then jumped between frames, so distant hills flickered in and out of the fog.
+            // Instead, apply only the camera's movement to the game's own matrix, which keeps depth and fog exact.
+            if ((proj.type == Projection::Type::Perspective) && !workload.debuggerCamera.enabled) {
+                interop::float4x4 gameViewProj = drawData.viewProjTransforms[proj.transformsIndex];
+                adjustProjectionMatrix(gameViewProj, projRatioScale);
+                const hlslpp::float4x4 gameView = drawData.viewTransforms[proj.transformsIndex];
+                const float viewDet = hlslpp::determinant(extract3x3(gameView));
+                if (std::isfinite(viewDet) && (fabsf(viewDet) > 1e-6f)) {
+                    const hlslpp::float4x4 gameViewInverse = hlslpp::inverse(gameView);
+                    viewProjMatrix = hlslpp::mul(hlslpp::mul(viewMatrix, gameViewInverse), gameViewProj);
+                    prevViewProjTransform = hlslpp::mul(hlslpp::mul(prevViewTransform, gameViewInverse), gameViewProj);
+                }
+            }
+
         }

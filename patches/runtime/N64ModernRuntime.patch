diff --git a/librecomp/src/sp.cpp b/librecomp/src/sp.cpp
index ae0f44f..fbe2555 100644
--- a/librecomp/src/sp.cpp
+++ b/librecomp/src/sp.cpp
@@ -9,7 +9,73 @@ extern "C" void osSpTaskLoad_recomp(uint8_t* rdram, recomp_context* ctx) {
 
 bool dump_frame = false;
 
+#if defined(__EMSCRIPTEN__)
+#include <mutex>
+// The graphics task yields as the RSP's would. The scheduler (bootup_061CF4) asks it to when an audio task is due, and
+// starts the audio task once the RSP reports back, then the graphics task again. The graphics task reports done only
+// once the renderer has finished with it (events.cpp), so with yields ignored the audio task waited for the renderer,
+// on a page through a stall of seconds while Firefox builds pipelines, and the VIs that would have rebuilt its command
+// list are held back for the stall (ULTRAMODERN_VIS_WAIT_FOR_RENDERER). The game's main thread goes on loading
+// meanwhile: the title demo's load freed the title's music buffers and gave their memory to the scheduler's lists, and
+// the audio task, started after the stall from its list of before it, wrote its samples over them: the page trapped in
+// the scheduler. Yielded at once, the audio task runs within the VI that built it. Its restart sends nothing to the
+// renderer, which has the task still: the report comes from whichever of the restart and the renderer's end comes last.
+namespace {
+    std::mutex gfx_task_mutex;
+    // Started and not reported done.
+    bool gfx_task_running = false;
+    // Reported yielded and not started again.
+    bool gfx_task_yielded = false;
+    // The renderer finished it while it was yielded.
+    bool gfx_task_rendered_yielded = false;
+    // Asked to yield again while yielded: it yields again as it starts again.
+    bool gfx_task_yield_wanted = false;
+}
+
+void sp_complete();
+
+// The renderer has finished the graphics task (events.cpp).
+void gfx_task_rendered() {
+    std::lock_guard lock{ gfx_task_mutex };
+    if (gfx_task_yielded) {
+        gfx_task_rendered_yielded = true;
+        return;
+    }
+    gfx_task_running = false;
+    gfx_task_yield_wanted = false;
+    sp_complete();
+}
+
+// osSpTaskStartGo of a graphics task: whether it is the yielded one started again, which the renderer has already.
+static bool gfx_task_started_again() {
+    std::lock_guard lock{ gfx_task_mutex };
+    if (!gfx_task_yielded) {
+        gfx_task_running = true;
+        gfx_task_yield_wanted = false;
+        return false;
+    }
+    gfx_task_yielded = false;
+    if (gfx_task_rendered_yielded) {
+        gfx_task_rendered_yielded = false;
+        gfx_task_running = false;
+        gfx_task_yield_wanted = false;
+        sp_complete();
+    }
+    else if (gfx_task_yield_wanted) {
+        gfx_task_yield_wanted = false;
+        gfx_task_yielded = true;
+        sp_complete();
+    }
+    return true;
+}
+#endif
+

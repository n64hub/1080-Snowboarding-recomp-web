diff --git a/librecomp/src/rsp.cpp b/librecomp/src/rsp.cpp
index 1cb3f6a..55569c8 100644
--- a/librecomp/src/rsp.cpp
+++ b/librecomp/src/rsp.cpp
@@ -54,6 +54,21 @@ bool recomp::rsp::run_task(uint8_t* rdram, const OSTask* task) {
     // Ensure that the ucode exited correctly
     if (exit_reason != RspExitReason::Broke) {
         fprintf(stderr, "RSP ucode %" PRIu32 " exited unexpectedly. exit_reason: %i\n", task->t.type, static_cast<int>(exit_reason));
+        static int reports = 0;
+        if (reports < 5) {
+            reports++;
+            fprintf(stderr, "[rsp] ucode %08X ucode_data %08X data_ptr %08X data_size %X\n", (unsigned)(uintptr_t)task->t.ucode, (unsigned)(uintptr_t)task->t.ucode_data, (unsigned)(uintptr_t)task->t.data_ptr, (unsigned)task->t.data_size);
+            fprintf(stderr, "[rsp] dmem 0x00:");
+            for (int i = 0; i < 0x40; i++) fprintf(stderr, " %02X", dmem[i ^ 3]);
+            fprintf(stderr, "\n[rsp] rdram:   ");
+            uint32_t ud = (uint32_t)(uintptr_t)task->t.ucode_data & 0xFFFFF8;
+            for (int i = 0; i < 0x40; i++) fprintf(stderr, " %02X", rdram[(ud + i) ^ 3]);
+            fprintf(stderr, "\n");
+        }
+        // A failed audio task costs one audio frame; carry on instead of quitting the game.
+        if (task->t.type == M_AUDTASK) {
+            return true;
+        }
         assert(exit_reason == RspExitReason::Broke);
         return false;
     }
